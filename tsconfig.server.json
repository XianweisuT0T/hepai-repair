{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build",
    "noEmitOnError": true,
    "sourceMap": false
  },
  "include": ["server/**/*.ts", "shared/arrangement.ts", "shared/types.ts"]
}
