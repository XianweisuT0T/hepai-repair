{
  "name": "hepai-repair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:pages": "npm run typecheck && vite build --mode pages && node scripts/finalize-pages.mjs",
    "start": "node build/server/index.js --production",
    "test": "tsx --test tests/server.test.ts",
    "test:e2e": "playwright test",
    "test:score": "tsx --test tests/score-world.test.ts",
    "test:static": "tsx --test tests/static-demo.test.ts",
    "test:lab": "tsx --test tests/lab3d-state.test.ts",
    "test:deployment": "npm run build && node --test tests/deployment.test.mjs",
    "test:e2e:lab": "playwright test tests/lab3d.spec.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "express": "5.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
