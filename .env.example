# Configure these in the hosting dashboard or process environment.
# The server does not automatically load .env files.
PORT=3001
DATA_DIR=/var/lib/hepai/data
SHARE_BASE_URL=https://your-actual-domain.example
# Optional. If omitted, SHARE_BASE_URL is the only allowed public browser origin.
# For a second exact domain, list both full origins separated by commas.
# ALLOWED_ORIGINS=https://your-actual-domain.example,https://your-second-domain.example
